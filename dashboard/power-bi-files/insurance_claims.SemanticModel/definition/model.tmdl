model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["claims_predictions","model_results","feature_importance"]

annotation PBI_ProTooling = ["DevMode"]

ref table claims_predictions
ref table model_results
ref table feature_importance

ref cultureInfo en-US

